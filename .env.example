NEXT_PUBLIC_APP_NAME=Quant Event Alpha Lab Taiwan
NEXT_PUBLIC_DATA_MODE=Hybrid
NEXT_PUBLIC_ENABLE_DEMO_DATA=true
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

ENABLE_OFFICIAL_DATA=true
TWSE_OPENAPI_BASE_URL=https://openapi.twse.com.tw/v1
TPEX_OPENAPI_BASE_URL=https://www.tpex.org.tw/openapi
OFFICIAL_DATA_TIMEOUT_MS=8000
OFFICIAL_DATA_REVALIDATE_SECONDS=3600
ENABLE_MOPS_PLACEHOLDER=true

DATABASE_URL=sqlite:///./backend/data/market_data.sqlite3
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MARKET_DATA_CACHE_SECONDS=10
ENABLE_FINMIND=false
FINMIND_API_TOKEN=
ENABLE_YFINANCE=true
