NEXT_PUBLIC_APP_NAME=Quant Event Alpha Lab Taiwan
NEXT_PUBLIC_DATA_MODE=Hybrid
NEXT_PUBLIC_ENABLE_DEMO_DATA=true
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Frontend auto refresh
NEXT_PUBLIC_ENABLE_AUTO_REFRESH=true
NEXT_PUBLIC_AUTO_REFRESH_INTERVAL_SECONDS=300
NEXT_PUBLIC_AUTO_REFRESH_SYMBOLS=2330,2382,2317,2308,3017,3037,3231,2603,2615,2454

ENABLE_OFFICIAL_DATA=true
TWSE_OPENAPI_BASE_URL=https://openapi.twse.com.tw/v1
TPEX_OPENAPI_BASE_URL=https://www.tpex.org.tw/openapi
OFFICIAL_DATA_TIMEOUT_MS=8000
OFFICIAL_DATA_REVALIDATE_SECONDS=3600
ENABLE_MOPS_PLACEHOLDER=true

DATABASE_URL=sqlite:///./backend/data/market_data.sqlite3
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MARKET_DATA_CACHE_SECONDS=10
ENABLE_FINMIND=false
FINMIND_API_TOKEN=
ENABLE_YFINANCE=true

# Backend scheduled refresh jobs
ENABLE_BACKEND_SCHEDULER=true
SCHEDULER_SYMBOLS=2330,2382,2317,2308,3017,3037,3231,2603,2615,2454
SCHEDULER_QUOTE_MINUTES=5
SCHEDULER_KLINE_MINUTES=60
SCHEDULER_QUANT_MINUTES=120
SCHEDULER_DIGEST_MINUTES=240
SCHEDULER_AI_MINUTES=360

# AI Quant Intelligence Layer
# Do NOT commit your real API key. Put the real value in backend/.env, Codespaces secrets, or deployment provider env vars.
ENABLE_AI_QUANT=false
ENABLE_AI_SCORE_IN_ALPHA=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_ITEMS_PER_RUN=20
AI_SCHEMA_VERSION=ai-quant-v1

# Safe source digest guardrails
ENABLE_PUBLIC_WEB_CRAWLER=false
CRAWLER_USER_AGENT=QuantEventAlphaLabTaiwan/0.1 research metadata bot; contact=local-user
CRAWLER_ALLOWED_DOMAINS=mops.twse.com.tw,openapi.twse.com.tw,www.twse.com.tw,www.tpex.org.tw,finmindtrade.com
CRAWLER_TIMEOUT_MS=8000
CRAWLER_MAX_PAGES_PER_RUN=12
CRAWLER_RESPECT_ROBOTS=true
CRAWLER_MIN_REQUEST_INTERVAL_MS=1200
